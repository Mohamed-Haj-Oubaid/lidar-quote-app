    "%@ (continued)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (Fortsetzung)"
          }
        }
      }
    },
    "%@ and its rooms are deleted on all devices.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ und die zugehörigen Räume werden auf allen Geräten gelöscht."
          }
        }
      }
    },
    "%@ and its rooms are deleted on all devices. Its %lld issued quotes stay on the server for commercial record-keeping.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ und die zugehörigen Räume werden auf allen Geräten gelöscht. Die %2$lld ausgestellten Angebote bleiben zur kaufmännischen Aufbewahrung auf dem Server."
          }
        }
      }
    },
    "%@ invited you to work with them in this app. Jobs and quotes you create will belong to this company.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat Sie eingeladen, in dieser App mitzuarbeiten. Ihre Aufträge und Angebote gehören dann zu dieser Firma."
          }
        }
      }
    },
    "%@ will never reach the server.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wird nie an den Server gesendet."
          }
        }
      }
    },
    "%@ will never reach the server. These dependent changes are discarded too: %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ wird nie an den Server gesendet. Diese abhängigen Änderungen werden ebenfalls verworfen: %2$@"
