            "value": "Entsperren, um auf Aufträge und Kundendaten zuzugreifen"
          }
        }
      }
    },
    "Upload to My Company": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In meine Firma hochladen"
          }
        }
      }
    },
    "Use a Different Email": {
      "localizations": {
        "de": {
