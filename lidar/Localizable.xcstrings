        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einzelpreis"
          }
        }
      }
    },
    "Unit prices, VAT and totals were checked by our server against this price book when the quote number was assigned.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einzelpreise, MwSt. und Summen wurden bei Vergabe der Angebotsnummer von unserem Server gegen diese Preisliste geprüft."
          }
        }
      }
    },
    "Unlock": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entsperren"
          }
        }
      }
