            "value": "Andere E-Mail verwenden"
          }
        }
      }
    },
    "Use the same movement as the main scanner. Capture the complete frame, the surrounding wall, and both solid sides. Avoid aiming only at glass.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewegen Sie das Gerät wie beim Raumscan. Erfassen Sie den ganzen Rahmen, die umgebende Wand und beide festen Seiten. Nicht nur auf das Glas zielen."
          }
        }
      }
    },
    "Used for": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwendet für"
          }
        }
      }
    },
    "VAT": {
