// Copy this file to Config/Secrets.xcconfig (git-ignored) and fill in your values.
//
// NOTE: "//" starts a comment in xcconfig files, so write the URL as
//       https:/$()/<project-ref>.supabase.co
// Only the PUBLISHABLE key belongs here – never the service_role / secret key.

SUPABASE_URL = https:/$()/YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY = sb_publishable_YOUR-KEY

// Your own reverse-DNS bundle identifier and (optionally) signing team.
PRODUCT_BUNDLE_IDENTIFIER = com.yourcompany.lidarquote
// DEVELOPMENT_TEAM = ABCDE12345
